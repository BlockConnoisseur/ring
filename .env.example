# Public origin; HTTPS in production. Run Next and the voice worker against the same persistent disk.
APP_ORIGIN=http://127.0.0.1:3320
RING_DB_PATH=.data/ring.sqlite
# Ring stays in prelaunch until these integrations are configured and RING_LIVE=true.
RING_LIVE=false
RING_TOKEN_MINT=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
RING_PHONE_NUMBER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
VOICE_PUBLIC_URL=
VOICE_PORT=3321
# Deepgram speech recognition and text-to-speech for the phone worker.
DEEPGRAM_API_KEY=
# Secret used to authenticate the configured execution adapter. Never expose to browser.
RING_EXECUTOR_URL=
RING_EXECUTOR_SECRET=
