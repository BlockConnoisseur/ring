# Public origin; HTTPS in production.
APP_ORIGIN=http://127.0.0.1:3320
# postgres for Supabase; sqlite for single-host local development.
RING_STORAGE=sqlite
# SERVER ONLY: restricted database login, never NEXT_PUBLIC_ or a browser key.
# Use the project's Connect dialog URI, replacing the login with ring_runtime.
RING_DATABASE_URL=
# Optional path to the CA downloaded from Supabase database settings. TLS is verified.
RING_DATABASE_CA=
RING_DB_PATH=.data/ring.sqlite
# Ring stays in prelaunch until these integrations are configured and RING_LIVE=true.
RING_LIVE=false
RING_TOKEN_MINT=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
RING_PHONE_NUMBER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
VOICE_PUBLIC_URL=
VOICE_PORT=3321
VOICE_HOST=127.0.0.1
# Concurrent games on one voice process. Provider/account capacity must also be verified.
RING_MAX_ACTIVE_CALLS=100
# Shared REST request limits; other apps using this Deepgram project share its quota.
DEEPGRAM_TTS_CONCURRENCY=12
DEEPGRAM_STT_CONCURRENCY=40
# Docker/Caddy only: DNS names pointing to your durable host.
APP_DOMAIN=
VOICE_DOMAIN=
# Deepgram speech recognition and text-to-speech for the phone worker.
DEEPGRAM_API_KEY=
# Permanent public origin for immutable, content-addressed token metadata and images.
RING_ASSET_ORIGIN=
# Turnkey keeps the Solana private key off the server. API credentials are executor-only.
RING_SIGNER=turnkey
TURNKEY_ORGANIZATION_ID=
TURNKEY_SIGNER_ADDRESS=
TURNKEY_API_PUBLIC_KEY=
TURNKEY_API_PRIVATE_KEY=
# Optional local/development mode: RING_SIGNER=keypair, absolute Solana CLI keypair path.
RING_AUTHORITY_KEYPAIR=
# Ring DBC pool, and its DAMM v2 pool once migrated. Signer remains creator/LP owner.
RING_DBC_POOL=
RING_DAMM_POOL=
# Receives creator fees before the first fee winner. Later winners replace it until another wins.
RING_INITIAL_FEE_RECIPIENT=
# Additional trusted hosts for the token's existing metadata JSON (comma-separated).
RING_METADATA_HOSTS=
