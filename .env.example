# Public origin; HTTPS in production. Run Next and the voice worker against the same persistent disk.
APP_ORIGIN=http://127.0.0.1:3320
RING_DB_PATH=.data/ring.sqlite
# Ring stays in prelaunch until these integrations are configured and RING_LIVE=true.
RING_LIVE=false
RING_TOKEN_MINT=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
RING_PHONE_NUMBER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
VOICE_PUBLIC_URL=
VOICE_PORT=3321
VOICE_HOST=127.0.0.1
# Docker/Caddy only: DNS names pointing to your durable host.
APP_DOMAIN=
VOICE_DOMAIN=
# Deepgram speech recognition and text-to-speech for the phone worker.
DEEPGRAM_API_KEY=
# Permanent public origin for immutable, content-addressed token metadata and images.
RING_ASSET_ORIGIN=
# Absolute path to a Solana CLI JSON keypair. The file must never be committed.
RING_AUTHORITY_KEYPAIR=
# Ring DBC pool, and its DAMM v2 pool once migrated. Signer remains creator/LP owner.
RING_DBC_POOL=
RING_DAMM_POOL=
# Receives creator fees before the first fee winner. Later winners replace it until another wins.
RING_INITIAL_FEE_RECIPIENT=
# Additional trusted hosts for the token's existing metadata JSON (comma-separated).
RING_METADATA_HOSTS=
